# 楽天市場商品検索・アフィリエイトリンク生成用(rakuten_threads_botと共通の値を使い回せます)
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# 記事生成に使用(claude_writer.py、2026-09-10からメイン)。
# 「claude setup-token」で発行する長期OAuthトークン(Claudeサブスクリプション契約が必要)。
# APIキー課金(ANTHROPIC_API_KEY)とは別物で、従量課金は発生しない。
CLAUDE_CODE_OAUTH_TOKEN=

# 任意。claude CLI実行ファイルの場所(通常は自動検出されたこのパスのままでよい)
# CLAUDE_CLI_PATH=C:\Users\naoya\tools\node\node-v24.21.0-win-x64\node_modules\@anthropic-ai\claude-code\bin\claude.exe

# 旧: Gemini API(無料枠)。ai_writer.py(未使用になったレガシー版)が使う。
# https://aistudio.google.com/apikey で無料発行できます。
GEMINI_API_KEY=

# Pexels API(無料)。情報系記事のヒーロー画像取得に使用。youtube_jidoと共有可能。
# https://www.pexels.com/api/ で無料発行できます。
PEXELS_API_KEY=

# 公開後のサイトURL(末尾スラッシュなし)。例: https://<GitHubユーザー名>.github.io/<リポジトリ名>
# sitemap.xml・canonicalタグ・OGタグの絶対URL生成に使用。未設定でもローカル生成は可能。
SITE_BASE_URL=

# 任意設定
SITE_ARTICLE_TYPE_RATIO=0.5
